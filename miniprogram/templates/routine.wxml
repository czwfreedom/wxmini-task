<template name="routine">
  <import src="../templates/abort.wxml"></import>
  <import src="../templates/dialog.wxml"></import>
  <import src="../templates/routineTemplates.wxml"></import>
  <view class="routine {{ style || '' }}">
    <view class="routine_content">
      <scroll-view wx:if="{{ loaded }}" class="routine_scroll" scroll-y="true">
        <!-- Hero 顶部（历史态加 past 褪色） -->
        <view class="routine_hero {{ isToday ? '' : 'past' }}">
          <view class="routine_hero_info">
            <!-- 日期导航：‹ 日期 › 三段式，点日期唤起系统选择器 -->
            <view class="routine_hero_nav">
              <view class="routine_hero_arrow" catch:tap="onPrevDay" hover-class="press">‹</view>
              <picker
                class="routine_hero_datewrap"
                mode="date"
                value="{{ pickerValue }}"
                start="2026-08-01"
                end="{{ pickerEnd }}"
                bindchange="onDatePicked"
              >
                <view class="routine_hero_label">{{ dateLabel }}</view>
                <view class="routine_hero_date">{{ dateMain }}</view>
              </picker>
              <!-- prettier-ignore -->
              <view class="routine_hero_arrow {{ !nextable ? 'disabled' : '' }}" catch:tap="onNextDay" hover-class="press">›</view>
            </view>

            <!-- prettier-ignore -->
            <view class="routine_hero_motto {{ isAllDone ? 'celebrate' : '' }}">
              ✦ {{ isAllDone ? '今天全搞定，太厉害了！🎉' : (addable ? '又是闪闪发光的一天！⭐' : '每一步都算数') }}
            </view>
            <view wx:if="{{ stats && stats.length}}" class="routine_hero_stats">
              <view
                wx:for="{{ stats }}"
                wx:for-item="stat"
                wx:for-index="sindex"
                wx:key="sindex"
                class="routine_hero_stat"
              >
                <view class="routine_hero_stat_dot {{ stat.style || '' }}"></view>
                <text>{{ stat.name }}</text>
              </view>
            </view>
          </view>

          <image class="routine_hero_logo" src="../assets/imgs/ic-pencil.svg" />
        </view>

        <!-- 任务列表 -->
        <view class="routine_section {{ isAllDone ? 'celebrate' : '' }}">
          {{ isToday ? (addable? '今天做点啥？' : '伙伴在做啥？') : '当日任务' }}
          <view
            wx:if="{{ addable }}"
            class="routine_section_tpl"
            catch:tap="onTemplateTap"
            hover-class="press"
          >
            <text class="routine_section_tpl_star">✦</text>
            <text>模板</text>
          </view>
        </view>

        <view class="routine_cards">
          <view
            wx:for="{{ records }}"
            wx:key="id"
            class="routine_card {{ item.style || '' }} {{ isToday && item.done ? 'harvest' : '' }}"
            catch:tap="{{ updateable && !item.holder? 'onItemTap' : '' }}"
            data-id="{{ item.id }}"
            hover-class="{{ updateable && !item.holder? 'press' : '' }}"
          >
            <view class="routine_card_main">
              <view class="routine_card_accent" style="background:{{ item.color }};"></view>
              <view class="routine_card_icon">
                <image src="{{ item.icon }}" class="routine_card_icon_img" mode="aspectFit" />
              </view>
              <view class="routine_card_body">
                <view class="routine_card_title">{{ item.name }}</view>
                <view wx:if="{{ item.detail }}" class="routine_card_sub">
                  {{ item.detail }}
                </view>
              </view>
              <view
                wx:if="{{ addable || finishable }}"
                class="routine_card_action"
                catch:tap="onItemTap"
                data-id="{{ item.id }}"
                data-button="next"
                hover-class="press"
                hover-stop-propagation="true"
              >
                <view wx:if="{{ item.holder }}" class="routine_card_btn holder">去添加</view>
                <view wx:elif="{{ !item.done && finishable }}" class="routine_card_btn">
                  去完成
                </view>
              </view>
            </view>

            <view wx:if="{{ item.remark }}" class="routine_card_remark_container">
              <text class="routine_card_remark">{{ item.remark }}</text>
              <view wx:if="{{ item.done }}" class="routine_card_stamp">
                <image
                  class="routine_card_stamp_img"
                  src="/assets/imgs/ic-stamp-done.svg"
                  mode="aspectFit"
                />
              </view>
            </view>

            <!-- 互动区：点赞 / 评论（仅 footer 数据存在时） -->
            <view
              wx:if="{{ item.footers && item.footers.length }}"
              class="routine_card_footer_container"
            >
              <view class="routine_card_footer">
                <view
                  wx:for="{{ item.footers }}"
                  wx:for-item="f"
                  wx:key="id"
                  class="routine_card_footer_item"
                  catch:tap="onItemMenuTap"
                  data-id="{{ item.id }}"
                  data-button="{{ f.id }}"
                  hover-class="press"
                  hover-stop-propagation="true"
                >
                  <image class="routine_card_footer_icon" src="{{ f.avatar }}" mode="aspectFit" />
                  <!-- prettier-ignore -->
                  <text class="routine_card_footer_num {{ f.selected? 'active' : '' }}">{{ f.name }}</text>
                </view>
              </view>
            </view>

            <!-- 评论区（展开时展示，关联面板；吸底输入条可常驻） -->
            <view wx:if="{{ item.commentVisible }}" class="routine_discuss_container">
              <view class="routine_discuss">
                <block wx:if="{{ item.comments && item.comments.length }}">
                  <view
                    wx:for="{{ item.comments }}"
                    wx:for-item="c"
                    wx:key="id"
                    class="routine_comment"
                  >
                    <view class="routine_comment_avatar {{ c.avatarStyle || 'c1' }}">
                      <text>{{ c.letterIndex }}</text>
                    </view>
                    <view class="routine_comment_main">
                      <view class="routine_comment_head">
                        <text class="routine_comment_name">{{ c.name }}</text>
                        <text class="routine_comment_time">{{ c.hint }}</text>
                      </view>
                      <text class="routine_comment_text">{{ c.desc }}</text>
                    </view>
                    <view wx:if="{{ c.editable }}" class="routine_comment_actions">
                      <image
                        class="routine_comment_action"
                        src="../assets/imgs/ic-edit.svg"
                        mode="aspectFit"
                        catch:tap="onCommentEdit"
                        data-id="{{ c.id }}"
                        hover-class="press"
                      />
                      <image
                        class="routine_comment_action"
                        src="../assets/imgs/ic-delete.svg"
                        mode="aspectFit"
                        catch:tap="onCommentDelete"
                        data-id="{{ c.id }}"
                        hover-class="press"
                      />
                    </view>
                  </view>
                </block>
                <view wx:else class="routine_comment_empty">还没有评论，写下第一条吧</view>

                <view
                  wx:if="{{ item.commentable }}"
                  class="routine_composer"
                  catch:tap="onComposerTap"
                  hover-class="press"
                >
                  <text class="routine_composer_ph">写评论…</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 空状态 -->
          <view wx:if="{{ records.length === 0 }}" class="routine_empty">
            <text class="routine_empty_text">
              {{ addable ? '还没有任务，去创建吧 🎉' : '这一天没有记录' }}
            </text>
          </view>

          <!-- 分享入口卡（仅今天态） -->
          <view
            wx:if="{{ isToday && addable }}"
            class="routine_share"
            catch:tap="onShareTap"
            hover-class="press"
          >
            <view class="routine_share_icon">
              <image
                class="routine_share_icon_img"
                src="../assets/imgs/ic-share.svg"
                mode="aspectFit"
              />
            </view>
            <view class="routine_share_body">
              <view class="routine_share_title">邀请伙伴围观我的任务</view>
              <view class="routine_share_sub">互相激励，一起坚持</view>
            </view>
            <view class="routine_share_arrow">›</view>
          </view>
        </view>

        <view class="routine_spacer"></view>
      </scroll-view>

      <!-- 回到今天胶囊（历史态） -->
      <view wx:if="{{ loaded && !isToday }}" class="routine_backtoday" catch:tap="onBackToday">
        <view class="routine_backtoday_dot"></view>
        <text class="routine_backtoday_text">回到今天</text>
      </view>
    </view>
  </view>

  <template
    wx:if="{{ templates && templates.id }}"
    is="routineTemplates"
    data="{{ ...templates }}"
  ></template>
  <template wx:if="{{ dialog && dialog.id }}" is="dialog" data="{{ ...dialog }}"></template>

  <template
    wx:if="{{ !loaded || abortMessage }}"
    is="abort"
    data="{{message: abortMessage || '加载中..' }}"
  ></template>
</template>
