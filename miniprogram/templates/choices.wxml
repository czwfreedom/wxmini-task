<!--
  Choices 通用底部弹窗模板
  数据驱动：id/items/limited/grid/modal 等字段全部由外部传入
  统一选中态：.sel.selected → #F4B942 描边 + #FFFDF8 底 + $gradient 打勾
-->
<template name="choices">
  <view wx:if="{{ id }}" class="choices">
    <!-- 遮罩 -->
    <view class="choices_mask" catch:tap="onChoicesMaskTap"></view>

    <!-- 底部弹窗面板 -->
    <view class="choices_sheet">
      <!-- 把手 -->
      <view class="choices_sheet_handle"></view>

      <!-- 单选：居中标题 + 关闭 -->
      <view wx:if="{{ limited === 1 }}" class="choices_sheet_title_row">
        <view class="choices_sheet_title">{{ title }}</view>
      </view>

      <!-- 多选：Header（取消 | 标题 | 确认） -->
      <view wx:else class="choices_sheet_header">
        <view class="choices_sheet_header_cancel" catch:tap="onChoicesCloseTap">取消</view>
        <view class="choices_sheet_header_title">{{ title }}</view>
        <view class="choices_sheet_header_confirm" catch:tap="onChoicesConfirmTap">{{ confirm || '确定' }}</view>
      </view>

      <!-- tips（items 上方） -->
      <view wx:if="{{ tips }}" class="choices_sheet_tip">{{ tips }}</view>

      <!-- grid 网格 -->
      <view class="choices_grid choices_grid_{{ grid }}">
        <view
          wx:for="{{ items }}"
          wx:key="id"
          class="choices_item sel {{ item.style || '' }}"
          catch:tap="onChoicesItemTap"
          data-id="{{ item.id }}"
        >
          <view wx:if="{{ item.style === 'selected' }}" class="sel_check">✓</view>

          <!-- grid='3': 大图标卡片模式 -->
          <view wx:if="{{ grid === '3' && item.avatar }}" class="choices_item_avatar_wrap">
            <image src="{{ item.avatar }}" class="choices_item_avatar_img" mode="aspectFit" />
          </view>

          <!-- grid='2'/'4': 小图标 -->
          <image
            wx:elif="{{ item.avatar }}"
            src="{{ item.avatar }}"
            class="choices_item_avatar"
            mode="aspectFit"
          />

          <view class="choices_item_name">{{ item.name }}</view>

          <view wx:if="{{ item.desc }}" class="choices_item_desc">{{ item.desc }}</view>
        </view>
      </view>

      <!-- 单选：底部取消按钮 -->
      <view wx:if="{{ limited === 1 }}" class="choices_sheet_cancel" catch:tap="onChoicesCloseTap">取消</view>
    </view>
  </view>
</template>
