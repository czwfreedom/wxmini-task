<!--
  Choices 通用底部弹窗模板
  数据驱动：id/items/limited/grid/modal 等字段全部由外部传入
  统一选中态：.sel.selected → #F4B942 描边 + #FFFDF8 底 + $gradient 打勾
-->
<template name="choices">
  <view wx:if="{{ id }}" class="common_dialog">
    <!-- 遮罩 -->
    <view class="common_dialog_mask" catch:tap="onChoicesMenuTap" data-button="cancel"></view>
    <!-- 底部弹窗面板 -->
    <view class="common_dialog_content">
      <view class="common_dialog_pre">
        <!-- 把手 -->
        <view class="common_dialog_handle"></view>
        <!-- 单选：居中标题 + 关闭 -->
        <view wx:if="{{ limited === 1 && title }}" class="common_dialog_title_container">
          <view class="common_dialog_title">{{ title }}</view>
        </view>

        <!-- 多选：Header（取消 | 标题 | 确认） -->
        <view wx:else class="common_dialog_header">
          <view
            class="common_dialog_header_cancel"
            catch:tap="onChoicesMenuTap"
            data-button="cancel"
          >
            取消
          </view>
          <view class="common_dialog_header_title">{{ title }}</view>
          <view
            class="common_dialog_header_confirm"
            catch:tap="onChoicesMenuTap"
            data-button="confirm"
          >
            {{ confirm || '确定' }}
          </view>
        </view>

        <!-- tips（items 上方） -->
        <view wx:if="{{ tips }}" class="common_dialog_tip">{{ tips }}</view>
      </view>

      <view class="common_dialog_items choices_grid {{ grid? 'grid' + grid : '' }}">
        <view
          wx:for="{{ items }}"
          wx:key="id"
          class="choices_item {{ grid? 'grid' : 'single' }} {{ item.selected? 'selected' : '' }}"
          catch:tap="onChoicesItemTap"
          data-id="{{ item.id }}"
        >
          <view wx:if="{{ item.avatar }}" class="choices_item_avatar_container">
            <image src="{{ item.avatar }}" class="choices_item_avatar" mode="aspectFit" />
          </view>
          <view
            class="choices_item_name {{ !grid? 'single' : '' }} {{ item.selected? 'selected' : '' }}"
          >
            {{ item.name }}
          </view>

          <view wx:if="{{ item.desc }}" class="choices_item_desc">{{ item.desc }}</view>
          <view wx:if="{{ item.selected && limited > 1 }}" class="choices_checked">✓</view>
        </view>
      </view>
      <!-- 单选：底部取消按钮 -->
      <view
        wx:if="{{ limited === 1 }}"
        class="common_dialog_cancel"
        hover-class="press"
        catch:tap="onChoicesMenuTap"
        data-button="cancel"
      >
        取消
      </view>
    </view>
  </view>
</template>
