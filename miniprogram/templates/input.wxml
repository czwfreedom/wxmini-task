<template name="input">
  <!-- 多行文本 -->
  <view wx:if="{{ type === 'textarea' }}" class="input_section">
    <view wx:if="{{ name }}" class="input_section_title">{{ name }}</view>
    <view wx:if="{{ header }}" class="input_text_hint">{{ header }}</view>
    <view class="input_text">
      <textarea
        class="input_text_input {{ style || '' }}"
        placeholder="{{  hint || '请输入' }}"
        maxlength="{{ maxLength || 400 }}"
        value="{{ value }}"
        data-id="{{ id }}"
        bindinput="onInputChanged"
        auto-height="true"
        disabled="{{ disabled || false }}"
      />

      <view class="input_text_footer">
        <view></view>
        <view class="input_text_count">
          {{ charCount }}/{{ maxLength || 400}}
        </view>
      </view>
    </view>

    <!-- 示例提示词（数据驱动，可能为空）：点击后填入正文 -->
    <view wx:if="{{ items && items.length }}" class="input_example_items">
      <view
        wx:for="{{ items }}"
        wx:key="id"
        class="input_example_item"
        catch:tap="onInputRadioTap"
        hover-class="press"
        data-id="{{ id }}"
        data-subid="{{ item.id }}"
        data-name="{{ item.name }}"
      >
        {{ item.name }}
      </view>
    </view>

    <!--
      底部提示区（数据驱动，可能为空）
      语义见 InputUI.VM.footer（Entity.Label）：
        name = 前缀（如「例如」）
        desc = 只读提示正文（用「·」分隔）—— 不可点、不代填
        hint = 可点入口文案 —— 点击有事件（如唤起角度列表弹窗）
      与上方 example 的区别：example 点了会填入正文，footer.desc 只是提示。
    -->
    <view wx:if="{{ footer }}" class="input_footer">
      <!-- ① 只读提示：无边框／无底色／无圆角，一眼就是「读的」不是「点的」 -->
      <view wx:if="{{ footer.name || footer.desc }}" class="input_footer_inspire">
        <text wx:if="{{ footer.name }}" class="input_footer_inspire_label">{{ footer.name }}</text>
        <text wx:if="{{ footer.desc }}" class="input_footer_inspire_text">{{ footer.desc }}</text>
      </view>

      <!-- ② 可点入口：唤起弹窗（事件由使用方绑定） -->
      <view
        wx:if="{{ footer.hint }}"
        class="input_footer_entry"
        catch:tap="onInputMenuTap"
        hover-class="press"
        data-id="{{ id }}"
        data-button="{{ footer.id || 'footer' }}"
      >
        <text class="input_footer_entry_text">{{ footer.hint }}</text>
        <view class="input_footer_entry_arrow"></view>
      </view>
    </view>
  </view>

  <!-- 带图文的单元选 -->
  <view wx:if="{{ type === 'gridRadio' }}" class="input_section">
    <view wx:if="{{ name }}" class="input_section_title">{{ name }}</view>
    <view class="input_grid {{ selectedId ? 'has-selected' : '' }}">
      <view
        wx:for="{{ items }}"
        wx:key="id"
        class="input_grid_cell {{ item.other? 'other' : '' }} {{ item.selected? 'selected' : '' }}"
        catch:tap="onInputRadioTap"
        data-id="{{ id }}"
        data-subid="{{ item.id }}"
        hover-class="press"
      >
        <view wx:if="{{ item.avatar }}" class="input_grid_icon {{ item.other? 'other' : '' }}">
          <image src="{{ item.avatar }}" mode="aspectFit" class="input_grid_icon_img" />
        </view>
        <view class="input_grid_name {{ item.other && !item.selected? 'other' : '' }}">
          {{ item.name }}
        </view>
        <view wx:if="{{ item.other }}" class="input_grid_hint">点击可选择</view>
        <view wx:if="{{ item.selected }}" class="input_checked">✓</view>
      </view>
    </view>
  </view>

  <!-- 带选择的短文本输出 -->
  <view wx:if="{{ type ==='optionInput' }}" class="input_section">
    <view wx:if="{{ name }}" class="input_section_title">{{ name }}</view>

    <view class="input_option_grid">
      <block wx:for="{{ items }}" wx:key="id">
        <view
          wx:if="{{ item.id !== 'custom' }}"
          class="input_option_cell {{ item.selected? 'selected' : '' }}"
          catch:tap="onInputRadioTap"
          hover-class="press"
          data-id="{{ id }}"
          data-subid="{{ item.id }}"
        >
          <!-- prettier-ignore -->
          <text wx:if="{{ item.name }}" class="input_option_value {{ item.selected? 'selected' : '' }}">{{ item.name }}</text>
          <text wx:if="{{ item.desc }}" class="input_option_unit">{{ item.desc }}</text>
        </view>

        <!-- "其他"单元格：点击后原地切换为输入框 -->
        <view
          wx:else
          class="input_option_cell {{ item.selected ? 'selected' : 'custom' }}"
          catch:tap="{{ item.selected ? '' : 'onInputRadioTap' }}"
          data-id="{{ id }}"
          data-subid="{{ item.id }}"
        >
          <block wx:if="{{ item.selected }}">
            <input
              class="input_option_custom_input"
              type="{{ subType || 'text' }}"
              placeholder="{{ hint || '输入'}}"
              maxlength="{{ maxLength || 3 }}"
              value="{{ value }}"
              data-id="{{ id }}"
              bindinput="onInputChanged"
              bindblur="onInputBlur"
              focus="{{ focused }}"
            />
            <text wx:if="{{ item.desc }}" class="input_option_custom_unit">{{ item.desc }}</text>
          </block>
          <block wx:else>其他</block>
        </view>
      </block>
    </view>
  </view>

  <!-- 4. 计划时间 -->
  <view wx:if="{{ type ==='optionTime' }}" class="input_section">
    <view class="input_section_title">
      {{ name}}
      <text wx:if="{{ hint }}" class="input_section_tip">{{ hint }}</text>
    </view>

    <view class="input_time_items">
      <block wx:for="{{ items }}" wx:key="id">
        <view
          wx:if="{{ item.id !== 'custom' }}"
          class="input_time_item {{ item.selected? 'selected' : '' }}"
          catch:tap="onInputRadioTap"
          hover-class="press"
          data-id="{{ id }}"
          data-subid="{{ item.id }}"
        >
          {{ item.name }}
        </view>

        <picker wx:else mode="time" value="{{ value }}" bindchange="onInputTimePicked">
          <view class="input_time_item {{ item.selected? 'selected' : '' }}">
            {{ value || item.name }}
          </view>
        </picker>
      </block>
    </view>
  </view>

  <!--
    5. 图片（九宫格）
    方案 B：「＋」是与图片同尺寸的一格，永远跟在图片流末尾，
    因此结构上不可能被其他元素隔开；满 mediaLimited 张时整格消失。
    空白态（items 为空）时 ＋ 格子带「添加图片」文字，有图后简化为纯 ＋。
  -->
  <view wx:if="{{ type ==='images' }}" class="input_section {{ !name? 'packed' : '' }}">
    <view wx:if="{{ name }}" class="input_section_title">
      {{ name }}
      <text wx:if="{{ hint }}" class="input_section_tip">{{ hint }}</text>
    </view>

    <view class="input_media_grid">
      <view
        wx:for="{{ items }}"
        wx:key="id"
        class="input_media_cell"
        catch:tap="onInputMediaTap"
        data-id="{{ id }}"
        data-subid="{{ item.id }}"
        data-button="preview"
      >
        <image src="{{ item.avatar }}" mode="aspectFill" class="input_media_cell_img" />
        <view
          wx:if="{{ mediaDeletable }}"
          class="input_media_cell_del"
          catch:tap="onInputMediaTap"
          hover-class="press"
          hover-stop-propagation="true"
          data-id="{{ id }}"
          data-subid="{{ item.id }}"
          data-button="del"
        >
          ×
        </view>
      </view>

      <!-- ＋ 格子：图片流末尾，未满时显示 -->
      <view
        wx:if="{{ !mediaLimited || (items && items.length < mediaLimited) }}"
        class="input_media_cell add"
        catch:tap="onInputMediaTap"
        hover-class="press"
        data-id="{{ id }}"
        data-button="add"
      >
        <view class="input_media_cell_inner">
          <!-- prettier-ignore -->
          <text class="input_media_cell_plus">＋</text>
          <text wx:if="{{ !items || !items.length }}" class="input_media_cell_label">添加图片</text>
        </view>
      </view>
    </view>

    <view wx:if="{{ items && items.length }}" class="input_media_count">
      {{ items.length }}/{{ mediaLimited || 9 }}
    </view>
  </view>

  <!--
    6. 音频（多条）
    三态：① 录音中（recording）② 已录制（items 非空，遍历）③ 去录音（默认）
    · 每条独立播放 / 删除，播放态由 item.selected 标记（同一时刻只播一条，由逻辑层保证）
    · 语音条宽度按时长：160rpx + 秒×4rpx，上限 480rpx（由 item.style 或 avatarStyle 承载，逻辑层计算）
    · 未满 mediaLimited 时显示「继续添加」；满则隐藏入口
    · 计数仅在有语音时显示（空白态不显示 0/9）
  -->
  <view wx:if="{{ type ==='audios' }}" class="input_section {{ !name? 'packed' : '' }}">
    <view wx:if="{{ name }}" class="input_section_title">
      {{ name }}
      <text wx:if="{{ hint }}" class="input_section_tip">{{ hint }}</text>
    </view>

    <!-- ① 录音中（最新一条） -->
    <view wx:if="{{ recording }}" class="input_voice recording">
      <view class="input_voice_dot"></view>
      <view class="input_voice_wave">
        <view class="w1"></view>
        <view class="w2"></view>
        <view class="w3"></view>
        <view class="w4"></view>
        <view class="w5"></view>
      </view>
      <text class="input_voice_time">{{ duration || 0 }}s</text>
      <view
        class="input_voice_stop"
        catch:tap="onInputMediaTap"
        hover-class="press"
        data-id="{{ id }}"
        data-button="stop"
      >
        完成
      </view>
    </view>

    <!-- ② 已录制：多条列表，每条独立 -->
    <view wx:else class="input_voice_list">
      <view
        wx:for="{{ items }}"
        wx:key="id"
        class="input_voice {{ item.selected ? 'playing' : '' }} {{ item.style || '' }}"
        style="{{ item.avatarStyle || '' }}"
        catch:tap="onInputMediaTap"
        data-id="{{ id }}"
        data-subid="{{ item.id }}"
        data-button="play"
      >
        <!-- 播放 / 停止：播放中显示方块（停止） -->
        <view class="input_voice_play"></view>
        <view class="input_voice_wave">
          <view class="w1"></view>
          <view class="w2"></view>
          <view class="w3"></view>
          <view class="w4"></view>
          <view class="w5"></view>
        </view>
        <text class="input_voice_dur">{{ item.name }}</text>
        <view
          wx:if="{{ mediaDeletable }}"
          class="input_voice_del"
          catch:tap="onInputMediaTap"
          hover-stop-propagation="true"
          data-id="{{ id }}"
          data-subid="{{ item.id }}"
          data-button="del"
        >
          ✕
        </view>
      </view>
    </view>

    <!-- ③ 录音 / 继续添加 入口：能力可见，未满时显示 -->
    <view
      wx:if="{{ (!mediaLimited || (items && items.length < mediaLimited)) && !recording }}"
      class="input_media_add"
      catch:tap="onInputMediaTap"
      hover-class="press"
      data-id="{{ id }}"
      data-button="add"
    >
      <image src="../assets/imgs/ic-record.svg" class="input_media_add_icon" mode="aspectFit" />
      <text>{{ items && items.length ? '继续添加' : '录音' }}</text>
    </view>

    <view wx:if="{{ items && items.length && !recording }}" class="input_media_count">
      语音 {{ items.length }}/{{ mediaLimited || 9 }}
    </view>
  </view>
</template>
