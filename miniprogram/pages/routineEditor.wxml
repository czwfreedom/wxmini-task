<import src="../templates/abort.wxml"></import>
<import src="../templates/choices.wxml"></import>

<view class="croutine">
  <view class="croutine_content">
    <scroll-view wx:if="{{ loaded }}" class="croutine_scroll" scroll-y="true" enhanced="{{ true }}">
      <!-- 1. 选择任务类型 -->
      <view class="croutine_section">
        <view class="croutine_section_title">任务类型</view>
        <view class="croutine_category {{ selectedCategoryId ? 'has-selected' : '' }}">
          <view
            wx:for="{{ categories }}"
            wx:key="id"
            class="croutine_category_cell {{ item.other? 'other' : '' }} {{ item.selected? 'selected' : '' }}"
            catch:tap="onCategoryTap"
            data-id="{{ item.id }}"
          >
            <view
              wx:if="{{ item.avatar }}"
              class="croutine_category_icon {{ item.other? 'other' : '' }}"
            >
              <image src="{{ item.avatar }}" mode="aspectFit" class="croutine_category_icon_img" />
            </view>
            <view class="croutine_category_name {{ item.other && !item.selected? 'other' : '' }}">
              {{ item.name }}
            </view>
            <view wx:if="{{ item.other }}" class="croutine_category_hint">点击可选择</view>
            <view wx:if="{{ item.selected }}" class="croutine_checked">✓</view>
          </view>
        </view>
      </view>

      <!-- 2. 任务内容 -->
      <view class="croutine_section">
        <view class="croutine_section_title">任务内容</view>

        <view class="croutine_detail">
          <textarea
            class="croutine_detail_input"
            placeholder="{{ selectedCategoryId ? '想做什么呢？' : '请先选择任务类型' }}"
            maxlength="{{ contentMaxLength }}"
            value="{{ contentText }}"
            bindinput="onContentInput"
            auto-height="{{ true }}"
            disabled="{{ !selectedCategoryId }}"
          />

          <view class="croutine_detail_footer">
            <view></view>
            <view class="croutine_detail_count">
              {{ contentCharCount }}/{{ contentMaxLength }}
            </view>
          </view>
        </view>

        <!-- 示例提示词（数据驱动，可能为空） -->
        <view
          wx:if="{{ contentExamples && contentExamples.length }}"
          class="croutine_example_items"
        >
          <view
            wx:for="{{ contentExamples }}"
            wx:key="id"
            class="croutine_example_item"
            catch:tap="onContentExampleTap"
            data-name="{{ item.name }}"
          >
            {{ item.name }}
          </view>
        </view>
      </view>

      <!-- 3. 计划时长 -->
      <view class="croutine_section">
        <view class="croutine_section_title">计划时长</view>

        <view class="croutine_duration_grid">
          <block wx:for="{{ durations }}" wx:key="id">
            <view
              wx:if="{{ item.id !== 'custom' }}"
              class="croutine_duration_cell {{ item.selected? 'selected' : '' }}"
              catch:tap="onDurationTap"
              data-id="{{ item.id }}"
            >
              <!-- prettier-ignore -->
              <text class="croutine_duration_value {{ item.selected? 'selected' : '' }}">{{ item.name }}</text>
              <text class="croutine_duration_unit">{{ item.desc }}</text>
            </view>

            <!-- "其他"单元格：点击后原地切换为输入框 -->
            <view
              wx:else
              class="croutine_duration_cell {{ item.selected ? 'selected' : 'custom' }}"
              catch:tap="{{ item.selected ? '' : 'onDurationTap' }}"
              data-id="{{ item.id }}"
            >
              <block wx:if="{{ item.selected }}">
                <input
                  class="croutine_duration_custom_input"
                  type="number"
                  placeholder="输入"
                  maxlength="{{ 3 }}"
                  value="{{ durationCustomText }}"
                  bindinput="onDurationCustomInput"
                  bindblur="onDurationCustomConfirm"
                  focus="{{ true }}"
                />
                <text class="croutine_duration_custom_unit">分钟</text>
              </block>
              <block wx:else>其他</block>
            </view>
          </block>
        </view>
      </view>

      <!-- 4. 计划时间 -->
      <view class="croutine_section">
        <view class="croutine_section_title">
          计划时间
          <text class="croutine_section_tip">可选，默认现在</text>
        </view>

        <view class="croutine_time_items">
          <block wx:for="{{ times }}" wx:key="id">
            <view
              wx:if="{{ item.id !== 'custom' }}"
              class="croutine_time_item {{ item.selected? 'selected' : '' }}"
              catch:tap="onTimeTap"
              data-id="{{ item.id }}"
            >
              {{ item.name }}
            </view>

            <picker wx:else mode="time" value="{{ timeCustomValue }}" bindchange="onTimePicked">
              <view class="croutine_time_item {{ item.selected? 'selected' : '' }}">
                {{ timeCustomValue || item.name }}
              </view>
            </picker>
          </block>
        </view>
      </view>
    </scroll-view>
  </view>
  <!-- CTA 底部按钮（固定浮层） -->
  <view class="croutine_cta">
    <view class="croutine_cta_btn {{ submittable ? '' : 'disabled' }}" catch:tap="onSubmitTap">
      <text>创建任务</text>
    </view>
  </view>
</view>

<!-- Choices 通用弹窗（更多分类等） -->
<template
  is="choices"
  data="{{ id: choices.id, title: choices.title, confirm: choices.confirm, items: choices.items, limited: choices.limited, grid: choices.grid, modal: choices.modal, tips: choices.tips }}"
></template>

<template
  wx:if="{{ !loaded || abortMessage }}"
  is="abort"
  data="{{message: abortMessage || '加载中..' }}"
></template>
