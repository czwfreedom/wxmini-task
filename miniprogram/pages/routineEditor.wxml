<import src="../templates/abort.wxml"></import>
<import src="../templates/choices.wxml"></import>
<import src="../templates/bottomBar.wxml"></import>
<import src="../templates/input.wxml"></import>

<view class="croutine">
  <view class="croutine_content">
    <scroll-view wx:if="{{ loaded }}" class="croutine_scroll" scroll-y="true">
      <!-- 1. 选择任务类型 -->
      <template
        wx:if="{{ !finishing && category && category.items }}"
        is="input"
        data="{{ ...category }}"
      ></template>

      <!-- 2. 任务内容 -->
      <template wx:if="{{ detail &&detail.id}}" is="input" data="{{ ...detail }}"></template>

      <!-- 时长 -->
      <template
        wx:if="{{ !finishing && duration && duration.items }}"
        is="input"
        data="{{ ...duration }}"
      ></template>

      <!-- 4. 计划时间 -->
      <template
        wx:if="{{ !finishing && time && time.items }}"
        is="input"
        data="{{ ...time }}"
      ></template>
      <view class="croutine_spacer"></view>
    </scroll-view>
  </view>
  <!-- CTA 底部按钮（通用 bottomBar 驱动） -->
  <template
    wx:if="{{ menus && menus.items && menus.items.length }}"
    is="bottomBar"
    data="{{ menus, keyboardHeight }}"
  ></template>
</view>

<!-- Choices 通用弹窗（更多分类等） -->
<template wx:if="{{ choices && choices.id }}" is="choices" data="{{ ...choices }}"></template>

<template
  wx:if="{{ !loaded || abortMessage }}"
  is="abort"
  data="{{message: abortMessage || '加载中..' }}"
></template>
