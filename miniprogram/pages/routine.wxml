<import src="../templates/abort.wxml"></import>

<view class="routine">
  <block wx:if="{{ loaded }}">
    <view class="routine_content">
      <scroll-view class="routine_scroll" scroll-y="true" enhanced="{{ true }}">
        <!-- Hero 顶部 -->
        <view class="routine_hero">
          <view class="routine_hero_info">
            <view class="routine_hero_label">今天是</view>
            <view class="routine_hero_date">{{ dateMain }}</view>
            <view class="routine_hero_motto">✦ 苟日新，日日新，又日新</view>
            <view wx:if="{{ stats && stats.length}}" class="routine_hero_stats">
              <view
                wx:for="{{ stats }}"
                wx:for-item="stat"
                wx:for-index="sindex"
                wx:key="sindex"
                class="routine_hero_stat"
              >
                <view class="routine_hero_stat_dot {{ stat.style || '' }}"></view>
                <text>{{ stat.name }}</text>
              </view>
            </view>
          </view>

          <image class="routine_hero_logo" src="../assets/imgs/ic-pencil.svg" />
        </view>

        <!-- 任务列表 -->
        <view class="routine_section">今日任务</view>

        <view class="routine_cards">
          <view
            wx:for="{{ records }}"
            wx:key="id"
            class="routine_card {{ item.style || '' }}"
            catch:tap="onTaskTap"
            data-id="{{ item.id }}"
            data-status="{{ item.status }}"
          >
            <view class="routine_card_accent" style="background:{{ item.color }};"></view>
            <view class="routine_card_icon">
              <image src="{{ item.icon }}" class="routine_card_icon_img" mode="aspectFit" />
            </view>
            <view class="routine_card_body">
              <view class="routine_card_title">{{ item.name }}</view>
              <view class="routine_card_sub">{{ item.categoryName }} · {{ item.detail }}</view>
              <view wx:if="{{ item.remark }}" class="routine_card_remark">"{{ item.remark }}"</view>
            </view>
            <view class="routine_card_action">
              <view wx:if="{{ item.status === 100 }}" class="routine_card_btn">去完成 →</view>
            </view>
            <image
              wx:if="{{ item.style === 'done' }}"
              class="routine_card_stamp"
              src="/assets/imgs/ic-stamp-done.svg"
              mode="aspectFit"
            />
          </view>

          <!-- 空状态 -->
          <view wx:if="{{ records.length === 0 }}" class="routine_empty">
            <text class="routine_empty_text">今天还没有任务，去创建吧 🎉</text>
          </view>

          <!-- 添加更多 -->
          <view class="routine_card_add" catch:tap="onAddTap">
            <view class="routine_card_add_icon">+</view>
            <text class="routine_card_add_text">添加更多任务</text>
          </view>
        </view>

        <view class="routine_spacer"></view>
      </scroll-view>

      <!-- 浮动按钮 -->
      <view class="routine_float">
        <view class="routine_float_btn">
          <image class="routine_float_icon" src="../assets/imgs/ic-logo.svg" />
        </view>
      </view>
    </view>
  </block>

  <template
    wx:else
    is="abort"
    data="{{ message: abortMessage || '加载中..', iconInvisible: true }}"
  ></template>
</view>
